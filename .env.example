# ローカル実行用の環境変数。このファイルを .env にコピーして値を埋める。
# （.env はgitignore済み。クラウド実行はGitHub Secretsを使うのでこのファイル不要）
#   cp .env.example .env

# Astra API（テーマ・編集プラン・挿絵・見た目評価）
OPENAI_API_KEY=
# auto: OpenAIキー登録時はAstra。それ以外は既存Claude。
# Astraのみを使う場合は openai、従来運用に固定する場合は anthropic。
YTSHORTS_LLM_PROVIDER=auto
YTSHORTS_OPENAI_MODEL=gpt-6-astra
YTSHORTS_OPENAI_REASONING_EFFORT=medium

# Claude API（従来環境の互換用。Astra運用では不要）
ANTHROPIC_API_KEY=

# GAS連携（値はGASエディタ > プロジェクトの設定 > スクリプト プロパティからコピー）
YTSHORTS_GAS_WEBAPP_URL=
GAS_ADMIN_TOKEN=
# デプロイが複数あるとき、make gas-deploy が更新する本番デプロイのID（URL中のAKfycb...）
GAS_DEPLOYMENT_ID=

# Slack（動画DL・ショートUP。作り直した最新アプリの xoxb- トークン）
SLACK_BOT_TOKEN=

# YouTube投稿（make publish する場合のみ必要）
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 文字起こしモデル。GPUなしのPCなら medium 推奨（large-v3は高精度だが重い）
YTSHORTS_WHISPER_MODEL=medium
