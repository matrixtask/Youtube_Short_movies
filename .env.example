# ローカル実行用の環境変数。このファイルを .env にコピーして値を埋める。
# （.env はgitignore済み。クラウド実行はGitHub Secretsを使うのでこのファイル不要）
#   cp .env.example .env

# Claude API（編集プラン・挿絵の生成）
ANTHROPIC_API_KEY=

# GAS連携（値はGASエディタ > プロジェクトの設定 > スクリプト プロパティからコピー）
YTSHORTS_GAS_WEBAPP_URL=
GAS_ADMIN_TOKEN=

# Slack（動画DL・ショートUP。作り直した最新アプリの xoxb- トークン）
SLACK_BOT_TOKEN=

# YouTube投稿（make publish する場合のみ必要）
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 文字起こしモデル。GPUなしのPCなら medium 推奨（large-v3は高精度だが重い）
YTSHORTS_WHISPER_MODEL=medium
